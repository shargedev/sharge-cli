---
import SiteLayout from '../layouts/SiteLayout.astro';
import packageJson from '../../../package.json';

const agentPrompt =
  '请阅读 https://github.com/shargedev/sharge-cli 的 README，按照其中的「Agent 快速开始」完成 sharge CLI 和 Skills 的安装；发起登录，在需要浏览器授权时提醒我操作，授权完成后验证安装是否成功。';

const manualInstall = `npm install --global @sharge/cli@latest
npx skills add shargedev/sharge-cli -y -g
sharge login
sharge auth status --json`;

const docsHref = `${import.meta.env.BASE_URL}docs/`;
const features = [
  {
    index: '01',
    title: 'Agent-first',
    body: '机器可读 help、稳定 JSON 契约和可安装 Skills，让 Agent 能发现、调用并验证每一步。',
  },
  {
    index: '02',
    title: '行为可预测',
    body: '不隐式读 stdin、不自动分页、不替你重试写入；结果、错误和退出码都有清晰边界。',
  },
  {
    index: '03',
    title: '安全可控',
    body: '最小权限登录、显式 dry run、破坏性操作确认，以及网络失败后的 unknown outcome 提示。',
  },
];

const capabilities = [
  { mark: 'N', title: 'Notes', body: '读取、搜索和管理闪记，并将音频、图片与视频安全下载到本地。' },
  { mark: 'C', title: 'Calendar', body: '查询日历，创建、更新和删除日程，管理 Todo 完成状态。' },
  { mark: 'R', title: 'Recordings', body: '按条件读取和搜索录音，获取转写、总结、高光与音频文件。' },
  { mark: 'D', title: 'Diary', body: '按月份读取、搜索日记，并获取包含 Markdown 正文的完整详情。' },
];

const workflow = [
  ['01', '发现命令', '按需读取 help 与具体命令契约'],
  ['02', 'dry run', '在零网络请求下预览写入计划'],
  ['03', '人类确认', '授权和破坏性操作保留给你决定'],
  ['04', '执行', '一次请求，结果去向清晰'],
  ['05', '结果恢复', '失败时保留上下文，避免盲目重试'],
];
---

<SiteLayout
  title="sharge CLI — 把 Sharge 交给你的 Agent"
  description="Sharge Open Platform 官方的 Agent-first CLI。让 Agent 安装并安全访问闪记、日历、录音和日记。"
>
  <main id="main-content">
    <section class="site-shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="identity"><span aria-hidden="true"></span>Sharge Open Platform 官方 CLI</p>
        <h1 id="hero-title">把 Sharge 交给你的 Agent</h1>
        <p class="lede">
          sharge 是 Sharge Open Platform 官方的 Agent-first CLI。一条 Prompt，即可让 Agent
          完成安装与授权，安全访问闪记、日历、录音和日记。
        </p>

        <section class="install-card" aria-label="安装 sharge CLI">
          <div class="tabs" role="tablist" aria-label="安装方式">
            <button
              id="agent-tab"
              role="tab"
              type="button"
              tabindex="0"
              aria-selected="true"
              aria-controls="agent-panel"
            >
              交给 Agent
            </button>
            <button
              id="manual-tab"
              role="tab"
              type="button"
              tabindex="-1"
              aria-selected="false"
              aria-controls="manual-panel"
            >
              手动安装
            </button>
          </div>

          <div id="agent-panel" class="install-panel" role="tabpanel" aria-labelledby="agent-tab">
            <p class="prompt-text">{agentPrompt}</p>
            <button class="copy-button" type="button" data-copy={agentPrompt} data-copy-label="复制 Prompt">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
              <span>复制 Prompt</span>
            </button>
          </div>

          <div id="manual-panel" class="install-panel" role="tabpanel" aria-labelledby="manual-tab" hidden>
            <pre><code>{manualInstall}</code></pre>
            <button class="copy-button" type="button" data-copy={manualInstall} data-copy-label="复制命令">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
              <span>复制命令</span>
            </button>
          </div>
          <p class="copy-status" aria-live="polite"></p>
        </section>
      </div>

      <aside class="terminal" aria-label="Agent 安装流程示意" data-terminal>
        <div class="terminal-bar">
          <span>Agent setup</span>
          <button type="button" data-terminal-replay aria-label="重新播放 Agent 安装流程">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.6"></path><path d="M4 4v4.6h4.6"></path></svg>
            重新播放
          </button>
        </div>
        <div class="terminal-body">
          <p class="terminal-command"><span>$</span> agent run install-sharge</p>
          <ol>
            <li style="--step: 0"><span class="marker neutral">→</span><span>正在读取 README…</span></li>
            <li style="--step: 1"><span class="marker success">✓</span><span>sharge CLI 已安装</span></li>
            <li style="--step: 2"><span class="marker success">✓</span><span>5 个 Agent Skills 已安装</span></li>
            <li style="--step: 3"><span class="marker neutral">→</span><span>等待浏览器授权</span></li>
            <li style="--step: 4"><span class="marker success">✓</span><span>身份验证成功</span></li>
          </ol>
        </div>
      </aside>
    </section>

    <section id="features" class="site-shell section-block" aria-labelledby="features-title">
      <div class="section-heading">
        <p>为 Agent，也为保持控制的人</p>
        <h2 id="features-title">自动化，不等于不确定</h2>
      </div>
      <div class="feature-grid">
        {features.map((feature) => (
          <article class="feature-item">
            <span class="item-index">{feature.index}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="capability-section" aria-labelledby="capabilities-title">
      <div class="site-shell">
        <div class="section-heading split-heading">
          <div>
            <p>一个 CLI，四类 Sharge 数据</p>
            <h2 id="capabilities-title">Agent 需要的能力，已经准备好</h2>
          </div>
          <a class="text-link" href={docsHref}>查看全部命令 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="capability-grid">
          {capabilities.map((capability) => (
            <article class="capability-item">
              <span class="capability-mark" aria-hidden="true">{capability.mark}</span>
              <div>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="site-shell workflow-section" aria-labelledby="workflow-title">
      <div class="workflow-intro">
        <p>安全工作流</p>
        <h2 id="workflow-title">Agent 能推进，人类仍然掌舵</h2>
        <p class="workflow-lede">从发现能力到执行与恢复，每一步都有明确边界。</p>
      </div>
      <ol class="workflow-list">
        {workflow.map(([index, title, body]) => (
          <li>
            <span class="workflow-index">{index}</span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="site-shell final-cta" aria-labelledby="cta-title">
      <div>
        <p>准备开始？</p>
        <h2 id="cta-title">把安装也交给 Agent</h2>
        <p>复制同一句 Prompt，让 Agent 从 README 获取最新安装步骤。</p>
      </div>
      <div class="cta-actions">
        <button class="secondary-copy" type="button" data-copy={agentPrompt} data-copy-label="复制 Prompt">
          复制 Prompt
        </button>
        <a href={docsHref}>阅读文档</a>
      </div>
      <p class="copy-status" aria-live="polite"></p>
    </section>
  </main>

  <footer>
    <div class="site-shell footer-inner">
      <p><strong>sharge CLI</strong><span>v{packageJson.version}</span></p>
      <nav aria-label="页脚导航">
        <a href="https://github.com/shargedev/sharge-cli" rel="noreferrer">GitHub</a>
        <a href="https://www.npmjs.com/package/@sharge/cli" rel="noreferrer">npm</a>
        <a href="https://github.com/shargedev/sharge-cli/blob/main/LICENSE" rel="noreferrer">License</a>
        <a href="https://github.com/shargedev/sharge-cli/blob/main/CHANGELOG.md" rel="noreferrer">Changelog</a>
      </nav>
    </div>
  </footer>
</SiteLayout>

<style>
  main { min-height: calc(100vh - 5rem); }
  .hero { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(23rem,.92fr); gap:clamp(3rem,7vw,7rem); align-items:center; min-height:calc(100vh - 5.5rem); padding-block:clamp(3.5rem,8vw,7rem); }
  .hero-copy,.terminal { min-width:0; }
  .identity,.section-heading>p,.section-heading>div>p,.workflow-intro>p:first-child,.final-cta>div>p:first-child { margin:0 0 1rem; color:var(--sg-text-secondary); font-size:.82rem; font-weight:600; }
  .identity { display:flex; align-items:center; gap:.65rem; }
  .identity span { width:.45rem; height:.45rem; border-radius:50%; background:var(--sg-success); box-shadow:0 0 0 4px color-mix(in srgb,var(--sg-success) 18%,transparent); }
  h1 { max-width:16ch; margin:0; font-size:clamp(2.6rem,4.4vw,3.5rem); font-weight:600; letter-spacing:-.045em; line-height:1.08; }
  .lede { max-width:38rem; margin:1.5rem 0 0; color:var(--sg-text-secondary); font-size:clamp(1rem,1.4vw,1.15rem); line-height:1.8; }
  .install-card { margin-top:2.25rem; padding:1rem; border:1px solid var(--sg-border); border-radius:var(--sg-radius-card); background:var(--sg-surface); box-shadow:var(--sg-shadow-card); backdrop-filter:blur(12px); }
  .tabs { display:grid; grid-template-columns:1fr 1fr; gap:.35rem; padding:.35rem; border:1px solid var(--sg-border); border-radius:.9rem; background:var(--sg-primary-softer); }
  .tabs button { min-height:2.65rem; border:0; border-radius:var(--sg-radius-control); color:var(--sg-text-secondary); font-weight:600; background:transparent; cursor:pointer; }
  .tabs button[aria-selected='true'] { color:var(--sg-primary-foreground); background:linear-gradient(100deg,var(--sg-primary),var(--sg-primary-end)); }
  .install-panel { padding-top:1rem; }
  .prompt-text,pre { margin:0; min-height:10.5rem; padding:1rem 1.1rem; border:1px solid var(--sg-border); border-radius:var(--sg-radius-code); line-height:1.75; background:color-mix(in srgb,var(--sg-surface-strong) 58%,transparent); }
  .prompt-text { user-select:text; }
  pre { overflow-x:auto; font-family:var(--sg-font-mono); font-size:.82rem; white-space:pre; }
  .copy-button,.secondary-copy,.cta-actions a { display:flex; align-items:center; justify-content:center; gap:.5rem; min-height:3rem; border-radius:var(--sg-radius-control); font-weight:600; cursor:pointer; }
  .copy-button { width:100%; margin-top:.8rem; border:0; color:var(--sg-primary-foreground); background:linear-gradient(100deg,var(--sg-primary),var(--sg-primary-end)); }
  .copy-button svg { width:1rem; fill:none; stroke:currentColor; stroke-width:1.8; }
  .copy-status { min-height:1.4rem; margin:.5rem 0 -.3rem; color:var(--sg-text-secondary); font-size:.78rem; text-align:center; }
  .copy-button:hover,.secondary-copy:hover { filter:brightness(1.08); }
  .terminal { overflow:hidden; border:1px solid rgb(255 255 255 / 12%); border-radius:var(--sg-radius-card); color:var(--sg-terminal-text); font-family:var(--sg-font-mono); background:linear-gradient(145deg,var(--sg-terminal-surface),var(--sg-terminal)); box-shadow:var(--sg-shadow-focal); }
  .terminal-bar { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; min-height:3.5rem; padding:.65rem 1rem; border-bottom:1px solid rgb(255 255 255 / 8%); color:var(--sg-terminal-muted); font-size:.76rem; }
  .terminal-bar>span { grid-column:2; }
  .terminal-bar button { grid-column:3; justify-self:end; display:flex; align-items:center; gap:.4rem; min-height:2.25rem; border:0; color:inherit; background:transparent; cursor:pointer; }
  .terminal-bar button:hover { color:var(--sg-terminal-text); }
  .terminal-bar svg { width:.9rem; fill:none; stroke:currentColor; stroke-width:1.8; }
  .terminal-body { min-height:27rem; padding:2rem clamp(1.5rem,4vw,2.5rem) 2.5rem; }
  .terminal-command { margin:0 0 2.25rem; font-size:.84rem; }
  .terminal-command span { color:var(--sg-terminal-muted); }
  .terminal ol { display:grid; gap:1.65rem; margin:0; padding:0; list-style:none; font-size:.86rem; line-height:1.55; }
  .terminal li { display:grid; grid-template-columns:1.25rem 1fr; gap:.25rem; }
  .terminal.is-playing li { opacity:0; transform:translateY(6px); animation:terminal-step 220ms ease forwards; animation-delay:calc(var(--step) * 420ms + 180ms); }
  .marker.neutral { color:var(--sg-terminal-muted); }
  .marker.success { color:var(--sg-success); }
  @keyframes terminal-step { to { opacity:1; transform:none; } }
  .section-block,.workflow-section { padding-block:var(--sg-space-24); }
  .section-heading { max-width:46rem; margin-bottom:var(--sg-space-12); }
  .section-heading h2,.workflow-intro h2,.final-cta h2 { margin:0; font-size:clamp(1.8rem,3vw,2.35rem); font-weight:600; letter-spacing:-.035em; line-height:1.2; }
  .feature-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--sg-grid-gap); }
  .feature-item { padding-top:1.5rem; border-top:1px solid var(--sg-border); }
  .item-index { color:var(--sg-text-muted); font-family:var(--sg-font-mono); font-size:.75rem; }
  .feature-item h3,.capability-item h3,.workflow-list h3 { margin:1rem 0 .6rem; font-size:1.15rem; }
  .feature-item p,.capability-item p,.workflow-list p,.workflow-lede,.final-cta>div>p:last-child { margin:0; color:var(--sg-text-secondary); line-height:1.75; }
  .capability-section { padding-block:var(--sg-space-24); background:color-mix(in srgb,var(--sg-bg-secondary) 64%,transparent); }
  .split-heading { display:flex; max-width:none; align-items:end; justify-content:space-between; gap:2rem; }
  .text-link { flex:none; padding-bottom:.3rem; border-bottom:1px solid var(--sg-border); color:var(--sg-text-secondary); font-size:.9rem; }
  .text-link:hover { color:var(--sg-text); }
  .capability-grid { display:grid; grid-template-columns:repeat(2,1fr); border-top:1px solid var(--sg-border); border-left:1px solid var(--sg-border); }
  .capability-item { display:grid; grid-template-columns:3.2rem 1fr; gap:1.25rem; min-width:0; padding:2rem; border-right:1px solid var(--sg-border); border-bottom:1px solid var(--sg-border); }
  .capability-mark { display:grid; width:3rem; height:3rem; place-items:center; border:1px solid var(--sg-border); border-radius:var(--sg-radius-control); color:var(--sg-text-secondary); font-family:var(--sg-font-mono); font-size:.8rem; background:var(--sg-surface); }
  .capability-item h3 { margin:0 0 .55rem; }
  .workflow-section { display:grid; grid-template-columns:minmax(18rem,.7fr) minmax(0,1.3fr); gap:clamp(3rem,8vw,8rem); }
  .workflow-intro { align-self:start; position:sticky; top:7rem; }
  .workflow-lede { margin-top:1.2rem; }
  .workflow-list { margin:0; padding:0; list-style:none; }
  .workflow-list li { display:grid; grid-template-columns:3rem 1fr; gap:1.25rem; padding:1.45rem 0; border-bottom:1px solid var(--sg-border); }
  .workflow-list li:first-child { border-top:1px solid var(--sg-border); }
  .workflow-index { padding-top:1.05rem; color:var(--sg-text-muted); font-family:var(--sg-font-mono); font-size:.75rem; }
  .workflow-list h3 { margin:0 0 .4rem; }
  .final-cta { display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center; margin-block:var(--sg-space-24); padding-block:var(--sg-space-12); border-top:1px solid var(--sg-border); border-bottom:1px solid var(--sg-border); }
  .final-cta>div>p:last-child { margin-top:1rem; }
  .cta-actions { display:flex; gap:.75rem; }
  .secondary-copy,.cta-actions a { min-width:9rem; padding:.65rem 1rem; }
  .secondary-copy { border:0; color:var(--sg-primary-foreground); background:var(--sg-primary); }
  .cta-actions a { border:1px solid var(--sg-border); background:var(--sg-surface); }
  .final-cta>.copy-status { grid-column:1/-1; margin-top:-1.25rem; }
  footer { border-top:1px solid var(--sg-border); }
  .footer-inner { display:flex; justify-content:space-between; align-items:center; gap:2rem; min-height:7rem; }
  .footer-inner p { display:flex; gap:.7rem; align-items:center; margin:0; }
  .footer-inner p span { color:var(--sg-text-muted); font-family:var(--sg-font-mono); font-size:.75rem; }
  .footer-inner nav { display:flex; gap:1.5rem; color:var(--sg-text-secondary); font-size:.85rem; }
  .footer-inner a:hover { color:var(--sg-text); }
  @media (max-width:980px) { .hero { grid-template-columns:1fr; gap:2.5rem; } .terminal-body { min-height:auto; } .workflow-section { grid-template-columns:1fr; gap:2.5rem; } .workflow-intro { position:static; } }
  @media (max-width:720px) { .feature-grid,.capability-grid { grid-template-columns:1fr; } .split-heading,.final-cta,.footer-inner { align-items:flex-start; flex-direction:column; } .split-heading { display:flex; } .final-cta { display:flex; } .cta-actions { width:100%; } .cta-actions>* { flex:1; } .footer-inner { display:flex; padding-block:2rem; } .footer-inner nav { flex-wrap:wrap; } }
  @media (max-width:540px) { .hero { padding-block:2.5rem 4rem; } h1 { font-size:clamp(2.35rem,10vw,2.5rem); } .install-card { margin-inline:-.25rem; padding:.65rem; border-radius:1rem; } .prompt-text,pre { min-height:0; padding:.9rem; font-size:.88rem; } .terminal-body { padding:1.5rem; } .terminal ol { font-size:.8rem; } .section-block,.capability-section,.workflow-section { padding-block:4rem; } .capability-item { padding:1.5rem 1rem; } .cta-actions { flex-direction:column; } .footer-inner nav { gap:1rem 1.25rem; } }
  @media (prefers-reduced-motion:reduce) { .terminal.is-playing li { opacity:1; transform:none; animation:none; } }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const selectTab = (tab: HTMLButtonElement) => {
    for (const item of tabs) {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(item.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !selected;
    }
    tab.focus();
  };
  for (const tab of tabs) {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const current = tabs.indexOf(tab);
      const target = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key === 'ArrowRight' ? (current + 1) % tabs.length : (current - 1 + tabs.length) % tabs.length;
      selectTab(tabs[target]);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const status = button.closest('section')?.querySelector<HTMLElement>('.copy-status');
      const label = button.dataset.copyLabel ?? '复制';
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        const labelNode = button.querySelector('span');
        if (labelNode) labelNode.textContent = '已复制'; else button.textContent = '已复制';
        if (status) status.textContent = '已复制到剪贴板';
        window.setTimeout(() => {
          if (labelNode) labelNode.textContent = label; else button.textContent = label;
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        if (status) status.textContent = '复制失败，请选择上方文本手动复制';
      }
    });
  }

  const terminal = document.querySelector<HTMLElement>('[data-terminal]');
  const playTerminal = () => {
    terminal?.classList.remove('is-playing');
    requestAnimationFrame(() => requestAnimationFrame(() => terminal?.classList.add('is-playing')));
  };
  if (terminal) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      playTerminal();
      observer.disconnect();
    }, { threshold: 0.25 });
    observer.observe(terminal);
  }
  document.querySelector('[data-terminal-replay]')?.addEventListener('click', () => {
    playTerminal();
  });
</script>
